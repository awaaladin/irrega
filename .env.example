# Copy to .env and edit. Nothing here is required for local demo: the app falls back to labelled simulated/template modes.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: leave empty for SQLite (local). Example Postgres:
# DATABASE_URL=postgres://irrigation:irrigation@db:5432/irrigation
DATABASE_URL=
# Shared Postgres: a role whose search_path is pinned to its own schema, and a session-mode URL for migrations.
DATABASE_URL_SESSION=
# Load another env file / run migrations through the session pooler:  ENV_FILE=.env.production DB_MODE=session

# AI explanations and Q&A. Empty = deterministic grounded template answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Satellite crop stress. simulated (labelled) or sentinelhub (needs the two values below).
SATELLITE_PROVIDER=simulated
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# Weather data older than this many hours is shown as stale and lowers confidence.
WEATHER_STALE_HOURS=6

# 1 = demo login, scenario switcher and judge walkthrough are available.
DEMO_MODE=1
